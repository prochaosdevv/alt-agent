{
  "name": "@x402-poc/agent",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:client": "esbuild src/client/wallet.ts --bundle --platform=browser --target=es2020 --format=iife --alias:@hiero-ledger/sdk=../../node_modules/@hiero-ledger/sdk/lib/browser.js --outfile=public/wallet-bundle.js",
    "dev": "npm run build:client && tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "npm run build:client && tsc"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.84",
    "@hashgraph/hedera-agent-kit": "^4.0.0",
    "@hashgraph/hedera-agent-kit-ai-sdk": "^1.0.0",
    "@hashgraph/hedera-wallet-connect": "^2.1.3",
    "@hiero-ledger/proto": "^2.31.0",
    "@hiero-ledger/sdk": "^2.85.0",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-controllers": "^1.8.23",
    "@reown/walletkit": "^1.5.6",
    "@walletconnect/modal": "^2.7.0",
    "@x402-poc/shared": "*",
    "@x402/core": "^2.18.0",
    "@x402/fetch": "^2.18.0",
    "@x402/hedera": "^2.18.0",
    "ai": "^6.0.86",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.15.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
