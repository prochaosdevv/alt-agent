# ── Testnet wallets ─────────────────────────────────────────────────────────
# Create ECDSA accounts at https://portal.hedera.com and fund with testnet HBAR
# Agent wallet (pays for inference)
HEDERA_AGENT_ACCOUNT_ID=0.0.XXXXX
HEDERA_AGENT_PRIVATE_KEY=0x...
# Service wallet (receives payments) — also needs USDC association (see SETUP.md)
HEDERA_SERVICE_ACCOUNT_ID=0.0.YYYYY
# Used by the associate script, the create-topic script, and by the running
# service to submit HCS audit log messages.
HEDERA_SERVICE_PRIVATE_KEY=0x...

# ── Mainnet wallets (optional — required to use Mainnet in the UI) ───────────
# Falls back to testnet credentials above if not set
HEDERA_AGENT_MAINNET_ACCOUNT_ID=0.0.AAAAA
HEDERA_AGENT_MAINNET_PRIVATE_KEY=0x...
HEDERA_SERVICE_MAINNET_ACCOUNT_ID=0.0.BBBBB
# To associate USDC for the mainnet service wallet, run scripts/associate-token.ts directly
# with HEDERA_ACCOUNT_ID / HEDERA_PRIVATE_KEY / HEDERA_NETWORK=mainnet passed inline — see
# README.md. Its private key isn't read from .env; nothing at runtime needs it stored here.

# ── Infrastructure ──────────────────────────────────────────────────────────
# Port the inference proxy listens on
PORT=4021
# Port the agent UI server listens on
AGENT_PORT=3001
# Facilitator URLs — auto-selected per network if not overridden
# Blocky402 testnet facilitator (required for AI & Agentic Payments track eligibility)
X402_TESTNET_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_MAINNET_FACILITATOR_URL=https://api.blocky402.com
# Inference service host, used by the agent SERVER for its own calls (do NOT append /v1).
# Plain local dev: leave unset (defaults to localhost:4021). Docker Compose: overridden to
# http://service:4021 (the internal network hostname) — see docker-compose.yml.
# INFERENCE_SERVICE_URL=http://localhost:4021
# Inference service host handed to the BROWSER (via /api/config) for its own direct
# wallet-connect calls (buying credits, paying per message). Must be reachable from wherever
# the browser runs — plain local dev: same as INFERENCE_SERVICE_URL, so leave unset. Docker
# Compose / a real deployment: set to your public host/domain, since the browser can't resolve
# internal Docker service names.
# PUBLIC_SERVICE_URL=http://localhost:4021

# ── AI providers ───────────────────────────────────────────────────────────
# At least one is required. Router tiers call real Claude / GPT models — see
# packages/service/src/providers.ts. Each x402-paid /infer call triggers a real,
# billed API call to whichever provider the tier maps to; a 512-token cap keeps
# per-call cost bounded, but you are paying real provider cost per demo request.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# Optional overrides — defaults shown. Verify these are still current model IDs
# in each provider's docs before relying on them.
# OPENAI_MODEL_SMALL=gpt-4o-mini
# ANTHROPIC_MODEL_DEFAULT=claude-sonnet-5
# ANTHROPIC_MODEL_LARGE=claude-opus-5

# ── HCS audit trail ────────────────────────────────────────────────────────
# Topic ID for the inference audit log. Create it once with:
#   npm run create-topic
# then paste the printed topic ID here.
HCS_TOPIC_ID=0.0.ZZZZZ

# ── Wallet connect (browser) ───────────────────────────────────────────────
# Free project ID from https://cloud.reown.com — lets visitors connect a Hedera
# wallet (HashPack, Blade, ...) via WalletConnect to buy prepaid credits.
WALLETCONNECT_PROJECT_ID=

# ── Credits (MongoDB-backed prepaid balance) ──────────────────────────────
# "Agent pays" mode requires prepaid credits, bought via a wallet-connected x402
# payment (see /credits/purchase/* in packages/service/src/server.ts) and drawn
# down per message. Needs a running MongoDB — local install or Atlas both work.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=x402_inference_poc
# Shared secret between the agent server and the service for the internal
# /credits/deduct and /credits/refund calls — not a real API-key system.
INTERNAL_API_KEY=
